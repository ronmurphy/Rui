<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="rui_root">
    <property name="orientation">vertical</property>
    
    <!-- Header Bar -->
    <child>
      <object class="GtkHeaderBar" id="header_bar">
        <child type="start">
          <object class="GtkMenuButton" id="hamburger_menu">
            <property name="icon-name">open-menu-symbolic</property>
          </object>
        </child>
        <property name="title-widget">
          <object class="GtkBox" id="header_toggle_box">
            <property name="orientation">horizontal</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkToggleButton" id="btn_design">
                <property name="label">Design</property>
                <property name="active">true</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="btn_code">
                <property name="label">Code</property>
                <property name="group">btn_design</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>

    <!-- Main Content Application -->
    <child>
      <object class="GtkPaned" id="main_paned">
        <property name="orientation">horizontal</property>
        <property name="position">230</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        
        <!-- Left Sidebar Notebook -->
        <child>
          <object class="GtkNotebook" id="left_nb">
            <property name="show-border">false</property>
            
            <child>
              <object class="GtkNotebookPage">
                <property name="tab-label">Tree</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="tree_view_scroll">
                    <child>
                      <object class="GtkBox" id="tree_placeholder" />
                    </child>
                  </object>
                </property>
              </object>
            </child>
            
            <child>
              <object class="GtkNotebookPage">
                <property name="tab-label">Widgets</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="widgets_view_scroll">
                    <child>
                      <object class="GtkBox" id="widgets_placeholder" />
                    </child>
                  </object>
                </property>
              </object>
            </child>
            
            <child>
              <object class="GtkNotebookPage">
                <property name="tab-label">Files</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="files_view_scroll">
                    <child>
                      <object class="GtkBox" id="files_placeholder" />
                    </child>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </child>

        <!-- Right Paned Wrapper (Center + Right Sidebar) -->
        <child>
          <object class="GtkPaned" id="right_paned">
            <property name="orientation">horizontal</property>
            
            <!-- Center Area (Toolbar + Canvas + Output) -->
            <child>
              <object class="GtkBox" id="center_area">
                <property name="orientation">vertical</property>
                
                <!-- Master Toolbar -->
                <child>
                  <object class="GtkBox" id="master_toolbar">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">2</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="toolbar"/>
                    </style>
                    <child>
                      <object class="GtkButton" id="btn_new_project">
                        <property name="label">New</property>
                        <style><class name="flat"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_open_project">
                        <property name="label">Open</property>
                        <style><class name="flat"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_save_all">
                        <property name="label">Save</property>
                        <style><class name="flat"/></style>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Center Notebook (Canvas / Code) -->
                <child>
                  <object class="GtkNotebook" id="center_nb">
                    <property name="show-tabs">false</property>
                    <property name="show-border">false</property>
                    <property name="hexpand">true</property>
                    <property name="vexpand">true</property>
                    
                    <child>
                      <object class="GtkNotebookPage">
                        <property name="tab-label">Design</property>
                        <property name="child">
                          <object class="GtkScrolledWindow" id="canvas_scroll_area">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <style>
                              <class name="designer-canvas"/>
                            </style>
                            <child>
                              <object class="GtkBox" id="canvas_placeholder">
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkNotebookPage">
                        <property name="tab-label">Code</property>
                        <property name="child">
                          <object class="GtkScrolledWindow" id="editor_scroll_area">
                            <child>
                              <object class="GtkBox" id="editor_placeholder"/>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Output Panel -->
                <child>
                  <object class="GtkBox" id="output_panel">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox" id="output_header">
                        <property name="orientation">horizontal</property>
                        <child>
                          <object class="GtkStackSwitcher" id="output_switcher">
                            <property name="stack">output_stack</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_close_output">
                            <property name="icon-name">window-close-symbolic</property>
                            <property name="hexpand">true</property>
                            <property name="halign">end</property>
                            <style><class name="flat"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStack" id="output_stack">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">output</property>
                            <property name="title">Output</property>
                            <property name="child">
                              <object class="GtkScrolledWindow"><child><object class="GtkTextView"/></child></object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                
              </object>
            </child>

            <!-- Right Sidebar Notebook -->
            <child>
              <object class="GtkNotebook" id="right_nb">
                <property name="show-border">false</property>
                <property name="width-request">260</property>

                <!-- Properties Tab -->
                <child>
                  <object class="GtkNotebookPage">
                    <property name="tab-label">Properties</property>
                    <property name="child">
                      <object class="GtkScrolledWindow" id="inspector_scroll">
                        <child>
                          <object class="GtkBox" id="inspector_placeholder"/>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- AI Chat Tab -->
                <child>
                  <object class="GtkNotebookPage">
                    <property name="tab-label">AI Chat</property>
                    <property name="child">
                      <object class="GtkBox" id="ai_box">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkStackSwitcher" id="ai_switcher">
                            <property name="stack">ai_stack</property>
                            <property name="halign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStack" id="ai_stack">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">web</property>
                                <property name="title">Web AI</property>
                                <property name="child">
                                  <object class="GtkBox"/>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">claude</property>
                                <property name="title">Claude</property>
                                <property name="child">
                                  <object class="GtkBox"/>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

  </object>
</interface>
